; Godot 4 project configuration — crash-remix
;
; Phase 0 config validated with the pinned Godot 4.7.1 editor/exporter.

config_version=5

[application]

config/name="Crash Remix"
config/description="Trilogy greatest-hits 3D platformer for Android. Personal fan project, sideload only."
config/icon="res://assets/icon.svg"
run/main_scene="res://scenes/game.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/show_image=false

[autoload]

PhaseState="*res://src/gameplay/phase/phase_state.gd"

[display]

; Sensor-landscape only (spec §5.2), allowing either landscape rotation.
window/size/viewport_width=1920
window/size/viewport_height=1080
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

; Multitouch must be fully independent: the stick never captures right-zone touches
; and a JUMP pressed mid-stick-reposition must register (spec §5.2).
pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=false

[physics]

; 60Hz physics with interpolation (spec §11.6). Gravity and jump arcs are hand-integrated
; in the character controller; physics only resolves collision.
common/physics_ticks_per_second=60
common/physics_interpolation=true
3d/physics_engine="Jolt Physics"

[rendering]

; Mobile renderer (Vulkan). NOT Forward+, NOT Compatibility (spec §11.2).
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
